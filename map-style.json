{
  "version": 8,
  "name": "GoPandaCN Dark",
  "metadata": {
    "gopandacn:note": "per-city vector source+layers (water/landuse/buildings/roads/roads-label) are added/removed at runtime by loadCityTiles() in gopandacn-prototype.html, not declared statically here — see ARCHITECTURE-ROADMAP.md § 3.2. This file only has the always-on world/China backdrop."
  },
  "glyphs": "fonts/{fontstack}/{range}.pbf",
  "sources": {
    "world-outline": {
      "type": "geojson",
      "data": "map-data/world-outline.geojson",
      "attribution": "© Natural Earth"
    },
    "china-provinces": {
      "type": "geojson",
      "data": "map-data/china-provinces.geojson",
      "attribution": "© Natural Earth"
    }
  },
  "layers": [
    { "id": "bg", "type": "background", "paint": { "background-color": "#0a1324" } },
    {
      "id": "country-fill",
      "type": "fill",
      "source": "world-outline",
      "maxzoom": 13,
      "paint": { "fill-color": "#101d33" }
    },
    {
      "id": "province-line",
      "type": "line",
      "source": "china-provinces",
      "minzoom": 3,
      "maxzoom": 13,
      "paint": { "line-color": "#20304d", "line-width": 0.6, "line-dasharray": [2, 2] }
    },
    {
      "id": "country-line",
      "type": "line",
      "source": "world-outline",
      "maxzoom": 13,
      "paint": { "line-color": "#2c3f5c", "line-width": ["interpolate", ["linear"], ["zoom"], 2, 0.5, 8, 1.4] }
    }
  ]
}
